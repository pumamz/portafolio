---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, path } from '../i18n/utils';
import { site } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import photo from '../assets/daniel.png';

interface Props {
  altPath?: string;
}

const { altPath } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = path(lang);

/**
 * Carril de identidad fijo. Sustituye a la cabecera flotante.
 *
 * ATENCION AL DOBLE PAPEL DE ESTE COMPONENTE.
 *
 * Todo lo marcado con `data-morph-to` es una REGLA DE MEDIR, no algo que
 * se vea. El script `hero-morph.ts` lee su posicion y su tamano para
 * saber adonde tiene que volar la pieza equivalente del hero, y el CSS lo
 * deja invisible mientras esa transformacion esta activa. Lo que el
 * visitante ve ahi al final del viaje son los elementos del hero, ya
 * aterrizados: los mismos nodos y los mismos enlaces.
 *
 * Por eso el contenido tiene que ser IDENTICO al del hero. Si aqui pone
 * "Proyectos" y en el hero "Ver proyectos", el texto cambia a mitad del
 * vuelo y se lee como un fallo, no como una transformacion.
 *
 * Si el script no corre —sin JavaScript, en movil, o con
 * `prefers-reduced-motion`— nada de esto se oculta y el carril funciona
 * como un carril normal.
 */
const nav = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#stack`, label: t('nav.stack') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#contact`, label: t('nav.contact') },
];

const socials = [
  { href: site.social.github, label: 'GitHub' },
  { href: site.social.linkedin, label: 'LinkedIn' },
].filter((s) => Boolean(s.href));

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');
---

{/* ---------------- Escritorio: columna fija ---------------- */}
<aside
  data-rail
  class="fixed inset-y-0 left-0 z-20 hidden w-64 lg:block"
  aria-label={t('hero.identity')}
>
  {
    /* El panel va aparte del contenido para poder desvanecerlo por su
      cuenta: durante el hero no debe haber una columna opaca partiendo la
      pantalla. Su opacidad la marca --morph-p, que escribe el script. */
  }
  <div aria-hidden="true" data-rail-panel class="bg-bg border-border/70 absolute inset-0 border-r">
  </div>

  <div class="relative flex h-full flex-col gap-8 overflow-y-auto px-7 py-8">
    <a href={home} class="block">
      {
        /* En vw y no en rem: el nombre del hero aterriza aqui, y el script
          calcula la escala como cociente de anchuras. Si las dos medidas
          no crecen igual con la ventana, el aterrizaje baila. */
      }
      <span class="poster block text-[clamp(1rem,1.4vw,1.6rem)]" data-morph-to="name">
        {firstName}<span class="text-accent ml-[0.26em]">{lastName}</span>
      </span>
      <span class="sr-only">{site.name}</span>
      <span data-rail-late class="text-text-muted mt-1.5 block text-xs">{t('hero.role')}</span>
    </a>

    {
      /* El filete va aparte del <nav>.

        Estaba puesto como borde superior del nav, y el nav se muestra de
        golpe al ceder el relevo: la linea aparecia de la nada en el ultimo
        instante. Como elemento propio entra fundiendose con el resto de lo
        que llega tarde. */
    }
    <div data-rail-late aria-hidden="true" class="border-border/70 border-t"></div>

    <nav data-morph-group="rail" aria-label={t('hero.index')} class="-mt-1 pt-6">
      <ul class="flex flex-col gap-3">
        {
          nav.map((item, i) => (
            <li>
              <a
                href={item.href}
                data-morph-to={`nav-${i}`}
                class="group inline-flex w-fit items-baseline gap-3 text-sm"
              >
                <span class="text-text-faint w-5 shrink-0 font-mono text-[0.6875rem] tabular-nums">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-text-muted">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /* mt-auto empuja el pie del carril al fondo de la ventana.

        El filete va en un hijo propio marcado como tardio, no como borde
        de este contenedor: un borde se pinta siempre, asi que se veia
        flotando sobre el hero antes de que el carril existiera. */
    }
    <div class="mt-auto flex flex-col gap-5 pt-7">
      <div
        data-rail-late
        aria-hidden="true"
        class="border-border/70 absolute inset-x-7 -mt-7 border-t"
      >
      </div>

      <div data-morph-to="photo" class="w-28">
        <div class="ring-outline relative overflow-hidden rounded-lg">
          <Image
            src={photo}
            alt=""
            width={224}
            densities={[1, 2]}
            loading="eager"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>

      <p data-rail-late class="text-text-faint flex items-center gap-2 text-xs">
        <Icon name="lucide:map-pin" class="size-3.5 shrink-0" aria-hidden="true" />
        {site.location[lang]}
      </p>

      {
        socials.length > 0 && (
          <ul class="flex flex-col gap-2.5">
            {socials.map((s, i) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-morph-to={`social-${i}`}
                  class="text-text-muted inline-flex items-center gap-1.5 font-mono text-xs tracking-widest uppercase"
                >
                  {s.label}
                  <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div data-rail-late class="flex items-center gap-2">
        <LanguageSwitcher altPath={altPath} />
        <ThemeToggle />
      </div>
    </div>
  </div>
</aside>

{
  /* ---------------- Movil: barra minima ----------------

    Por debajo de lg no cabe una columna fija sin comerse la mitad de la
    pantalla, asi que el carril se pliega en una tira con el nombre y un
    desplegable. Aqui no hay transformacion ninguna: el hero no tiene
    sitio del que salir. Sigue sin JavaScript de framework: <details>
    nativo. Coste asumido: no se cierra con Escape ni al pulsar un
    enlace. */
}
<header class="border-border/70 bg-bg fixed inset-x-0 top-0 z-40 border-b lg:hidden">
  <div class="flex items-center justify-between gap-4 px-5 py-3">
    <a href={home} class="poster text-lg">
      {firstName}<span class="text-accent ml-[0.26em]">{lastName}</span>
    </a>

    <div class="flex items-center gap-2">
      <LanguageSwitcher altPath={altPath} />
      <ThemeToggle />
    </div>
  </div>

  <details class="group border-border/70 border-t">
    <summary
      class="text-text-muted flex cursor-pointer items-center justify-between px-5 py-2.5 text-sm marker:content-none [&::-webkit-details-marker]:hidden"
    >
      {t('nav.toggleMenu')}
      <Icon
        name="lucide:chevron-down"
        class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-open:rotate-180 motion-reduce:transition-none"
        aria-hidden="true"
      />
    </summary>
    <ul class="flex flex-col gap-0.5 px-3 pb-3">
      {
        nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="text-text hover:bg-text/5 flex items-baseline gap-3 rounded-xl px-2 py-2.5 text-sm"
            >
              <span class="text-text-faint w-5 shrink-0 font-mono text-[0.6875rem] tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</header>
