---
import { getLangFromUrl, useTranslations, path, routes } from '../i18n/utils';
import { site } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  altPath?: string;
}

const { altPath } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = path(lang);

const nav = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#stack`, label: t('nav.stack') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

{
  /* `sticky` en lugar de `fixed`: no se superpone al contenido al final de
    la pagina ni requiere compensar con padding en el body.
    El desenfoque de fondo mantiene legible el texto que pasa por debajo. */
}
<header class="border-border/60 bg-bg/80 sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
    <a
      href={home}
      class="font-display hover:text-accent text-lg tracking-tight transition-colors duration-150"
    >
      {site.name}
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label={t('nav.work')} class="hidden md:block">
        <ul class="flex items-center gap-6">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-text-muted hover:text-text decoration-accent text-sm underline-offset-4 transition-colors duration-150 hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <LanguageSwitcher altPath={altPath} />
        <ThemeToggle />
      </div>
    </div>
  </div>

  {
    /* Navegacion movil sin JavaScript, con <details> nativo.
      Coste asumido: no se cierra con Escape ni al pulsar un enlace.
      A cambio, cero kilobytes de JavaScript para un menu de cuatro enlaces. */
  }
  <details class="group border-border/60 border-t md:hidden">
    <summary
      class="text-text-muted flex cursor-pointer items-center justify-between px-6 py-3 text-sm marker:content-none [&::-webkit-details-marker]:hidden"
    >
      {t('nav.toggleMenu')}
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="size-4 transition-transform duration-300 group-open:rotate-180 motion-reduce:transition-none"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <ul class="flex flex-col gap-1 px-6 pb-4">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="text-text block py-2 text-base">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</header>
