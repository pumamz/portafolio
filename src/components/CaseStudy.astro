---
import { render } from 'astro:content';
import type { Project } from '../lib/projects';
import { workIndexUrl } from '../lib/projects';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const d = project.data;
const lang = d.lang as Lang;
const t = useTranslations(lang);

const { Content } = await render(project);
// `body` vacio significa que el fichero solo tiene frontmatter: en ese caso
// no se pinta el bloque de contenido largo para no dejar un hueco.
const hasBody = Boolean(project.body?.trim());

const sections = [
  { label: t('work.problem'), text: d.problem },
  { label: t('work.solution'), text: d.solution },
  { label: t('work.impact'), text: d.impact },
];

const meta = [
  { label: t('work.role'), value: d.role },
  { label: t('work.period'), value: d.period },
];
---

<article class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
  <a
    href={workIndexUrl(lang)}
    class="text-text-muted hover:text-accent inline-flex items-center gap-2 text-sm transition-colors duration-150"
  >
    <span aria-hidden="true">&larr;</span>
    {t('work.back')}
  </a>

  <header class="mt-10">
    <h1 class="text-4xl">{d.title}</h1>
    <p class="text-text-muted mt-5 max-w-prose text-lg text-balance">{d.tagline}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      {
        d.liveUrl && (
          <a
            href={d.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent text-on-accent hover:bg-accent-hover rounded-full px-6 py-3 text-sm font-medium transition-colors duration-150"
          >
            {t('work.viewLive')} &nearr;
          </a>
        )
      }
      {
        d.repoUrl && (
          <a
            href={d.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border-strong hover:border-accent hover:text-accent rounded-full border px-6 py-3 text-sm font-medium transition-colors duration-150"
          >
            {t('work.viewCode')} &nearr;
          </a>
        )
      }
    </div>
  </header>

  <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
    <div class="space-y-12">
      {
        sections.map((section) => (
          <section>
            <h2 class="text-text-faint border-border border-b pb-2 font-mono text-xs tracking-widest uppercase">
              {section.label}
            </h2>
            <p class="text-text mt-5 max-w-prose text-lg">{section.text}</p>
          </section>
        ))
      }

      {
        hasBody && (
          <div class="text-text-muted border-border max-w-prose space-y-4 border-t pt-8 text-base">
            <Content />
          </div>
        )
      }
    </div>

    <aside class="space-y-8 lg:sticky lg:top-28 lg:self-start">
      <dl class="space-y-4">
        {
          meta.map((item) => (
            <div>
              <dt class="text-text-faint font-mono text-xs tracking-widest uppercase">
                {item.label}
              </dt>
              <dd class="text-text mt-1.5 text-sm">{item.value}</dd>
            </div>
          ))
        }
      </dl>

      <div>
        <h2 class="text-text-faint font-mono text-xs tracking-widest uppercase">
          {t('work.stack')}
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            d.stack.map((tech) => (
              <li class="border-border text-text-muted rounded-full border px-3 py-1 font-mono text-xs">
                {tech}
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</article>
