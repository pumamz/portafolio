---
/**
 * Arranque de los efectos de cliente.
 *
 * No renderiza nada: solo engancha comportamientos sobre elementos que ya
 * existen (inclinacion de tarjetas, capa ambiental y la transformacion
 * del hero en el carril lateral).
 *
 * Dos efectos se retiraron a peticion del autor, y conviene recordar por
 * que: el cursor personalizado obligaba a acertar en todos los casos
 * (campos de texto, bordes de ventana, carga lenta) y estorbaba mas de lo
 * que aportaba; los botones magneticos movian el destino del clic justo
 * cuando el visitante apuntaba a el.
 */
---

<script>
  import { initPointerEffects, destroyPointerEffects } from '../scripts/pointer-effects';
  import { initAmbient, destroyAmbient } from '../scripts/ambient';
  import { initHeroMorph, destroyHeroMorph } from '../scripts/hero-morph';

  const start = () => {
    initPointerEffects();
    initAmbient();
    // Despues de las otras dos: mide cajas, y conviene que el resto ya
    // haya hecho lo suyo antes de tomar medidas.
    initHeroMorph();
  };

  const stop = () => {
    destroyPointerEffects();
    destroyAmbient();
    destroyHeroMorph();
  };

  start();

  // Con view transitions el <body> se reemplaza: hay que soltar las
  // escuchas de los nodos viejos y volver a engancharlas a los nuevos.
  document.addEventListener('astro:before-swap', stop);
  document.addEventListener('astro:after-swap', start);
</script>
