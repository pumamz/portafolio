---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, path } from '../../i18n/utils';
import { site } from '../../config/site';
import photo from '../../assets/daniel.png';

/**
 * Hero de cartel que se transforma en el carril lateral al desplazar.
 *
 * La composicion es deliberadamente desequilibrada: arriba a la izquierda
 * una linea pequena que dice de que va esto, en medio vacio, y abajo el
 * nombre a sangre. Ese vacio central es lo que hace que el nombre pese.
 *
 * TODO LO MARCADO CON `data-morph` VUELA. Su pareja en el carril lleva el
 * mismo `data-morph-to`, y `hero-morph.ts` mide las dos posiciones y
 * resta. Aqui no hay ni una coordenada escrita a mano: si cambia un
 * padding o el ancho del carril, el destino se recalcula solo.
 *
 * Condicion para emparejar: el contenido tiene que ser IDENTICO a los dos
 * lados. Lo que no tiene equivalente exacto —la afirmacion, el texto de
 * apoyo, las llamadas a la accion— no vuela: se va con el scroll como
 * cualquier contenido normal. Hacer viajar dos textos distintos se lee
 * como un fallo de render, no como una transformacion.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = path(lang);

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: 'GitHub' },
  { href: site.social.linkedin, label: 'LinkedIn' },
].filter((s) => Boolean(s.href));

const nav = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#stack`, label: t('nav.stack') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

{
  /* Sin `overflow-hidden` en la seccion: las piezas que vuelan salen de su
    caja por arriba y a la izquierda, y un recorte aqui las decapitaria a
    mitad del viaje. El recorte se aplica solo a las capas de fondo, que
    son las unicas que se desbordan de verdad.

    `z-30` la pone por encima del panel del carril (z-20), que es adonde
    aterrizan las piezas, y por encima de las secciones que vienen
    despues, que no llevan z-index. */
}
{
  /* EL CONTENEDOR ALTO ES EL QUE BLOQUEA EL SCROLL.

    Mide 190vh a partir de lg: una pantalla para el hero y el resto para
    recorrer la transformacion. La seccion va dentro en `sticky top-0`,
    asi que se queda quieta mientras se atraviesa ese alto y solo se
    marcha cuando el contenedor se acaba. Eso es lo que hace que el hero
    parezca bloqueado sin secuestrar la rueda del raton: el scroll sigue
    siendo el del navegador, con su inercia y su barra, y quien quiera
    pasar de largo puede hacerlo.

    En movil no hay carril al que transformarse, asi que no hay bloqueo:
    el contenedor no tiene alto extra y la seccion no se ancla. */
}
<div data-morph-pin class="relative lg:h-[190vh]">
  <section
    data-morph-root
    data-reactive-grid
    class="full-bleed relative z-30 flex min-h-[calc(100dvh-6.5rem)] flex-col justify-between px-6 pt-10 pb-10 sm:px-10 sm:pt-12 lg:sticky lg:top-0 lg:h-screen lg:min-h-0 lg:pt-16"
  >
    <div
      aria-hidden="true"
      data-hero-exit
      class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
    >
      {
        /* Foco que sigue al puntero. Las variables --grid-x / --grid-y las
        escribe el script de la rejilla reactiva sobre la seccion; esta
        capa solo las lee. NO declararlas aqui: una propiedad declarada en
        el hijo gana a la heredada y el foco se queda clavado en el
        centro. Paso exactamente eso. */
      }
      <div class="spotlight text-text absolute inset-0"></div>
      <div class="grain absolute inset-0"></div>
    </div>

    {/* ---------------- Cabecera de la composicion ---------------- */}
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div data-hero-fade class="reveal" style="--delay: 60ms">
        <p class="font-display text-lg sm:text-xl" style="font-stretch: 85%; font-weight: 700">
          {t('hero.claim.line1')}{' '}
          <span class="text-accent">{t('hero.claim.line2')}</span>
        </p>
        <p class="text-text-faint mt-2 font-mono text-[0.6875rem] tracking-[0.2em] uppercase">
          {t('hero.meta')} / {year}
        </p>
      </div>

      {
        /* El indice del hero ES el del carril: estos mismos enlaces vuelan
        hasta alla. Oculto por debajo de lg, donde manda la tira superior. */
      }
      <nav aria-label={t('hero.index')} class="hidden lg:block">
        <ul class="flex flex-wrap items-baseline gap-x-7 gap-y-2">
          {
            nav.map((item, i) => (
              <li>
                <a
                  href={item.href}
                  data-morph={`nav-${i}`}
                  class="group inline-flex items-baseline gap-3 text-sm"
                >
                  <span class="text-text-faint group-hover:text-accent w-5 shrink-0 font-mono text-[0.6875rem] tabular-nums transition-colors duration-300">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-text-muted group-hover:text-text transition-colors duration-300">
                    {item.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* ---------------- Bloque del nombre ---------------- */}
    <div class="mt-16">
      <div class="flex items-end justify-between gap-8">
        <p
          data-hero-fade
          class="reveal text-text-muted max-w-[34ch] text-sm text-pretty sm:text-base"
          style="--delay: 160ms"
        >
          {t('hero.claim.support')}
        </p>

        <div data-morph="photo" class="hidden w-40 shrink-0 sm:block lg:w-48">
          <div class="ring-outline relative overflow-hidden rounded-xl">
            <Image
              src={photo}
              alt={t('about.photoAlt')}
              width={420}
              densities={[1, 2]}
              loading="eager"
              class="aspect-[4/5] w-full object-cover"
            />
          </div>
        </div>
      </div>

      {
        /* El cuerpo se ata al ancho de la ventana con vw, no a la escala
        tipografica del sistema: es lo que hace que el nombre llegue de
        borde a borde en cualquier pantalla. La firma del carril tambien
        esta en vw, para que el cociente de escala del viaje no cambie al
        redimensionar. */
      }
      <h1
        data-morph="name"
        class="poster mt-6 text-[clamp(3rem,13vw,13rem)]"
        aria-label={site.name}
      >
        {
          /* El espacio entre nombre y apellido es un margen, no un caracter:
          un espacio suelto entre expresiones desaparece al formatear el
          fichero —paso, quedaba "DanielPuma"— y a este cuerpo el espacio
          de la fuente es demasiado ancho. */
        }
        <span aria-hidden="true"
          >{firstName}<span class="text-accent ml-[0.26em]">{lastName}</span></span
        >
      </h1>

      {
        /* La linea va en su propio elemento y no como borde de la barra: la
        barra no puede apagarse porque lleva dentro las redes, que vuelan.
        El filete si se apaga con el resto del hero. */
      }
      <div data-hero-fade aria-hidden="true" class="border-border/70 mt-8 border-t"></div>

      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 pt-6">
        <a
          href={`${home}#work`}
          data-hero-fade
          class="group text-text hover:text-accent reveal inline-flex items-center gap-2.5 text-sm font-medium transition-colors duration-300"
          style="--delay: 320ms"
        >
          <Icon
            name="lucide:arrow-down"
            class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-y-0.5 motion-reduce:group-hover:translate-y-0"
            aria-hidden="true"
          />
          {t('hero.cta.secondary')}
        </a>

        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            socials.map((s, i) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-morph={`social-${i}`}
                  class="text-text-muted hover:text-accent group inline-flex items-center gap-1.5 font-mono text-xs tracking-widest uppercase transition-colors duration-300"
                >
                  {s.label}
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:group-hover:translate-x-0 motion-reduce:group-hover:translate-y-0"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
          <li data-hero-fade class="reveal" style="--delay: 380ms">
            <a
              href={`${home}#contact`}
              class="bg-accent text-on-accent hover:bg-accent-hover inline-flex items-center rounded-full px-5 py-2 text-sm font-medium transition-colors duration-300"
            >
              {t('hero.cta.primary')}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</div>

<style>
  /* Entrada escalonada al cargar. Nada que ver con la transformacion al
     carril, que la gobierna el scroll: esto solo es la llegada inicial.
     Cada elemento lleva su propio --delay inline, lo que evita escribir
     una regla CSS por elemento. */
  .reveal {
    animation: reveal 900ms var(--ease-fluid) both;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* La regla global de global.css ya neutraliza las animaciones, pero
     `both` deja el estado inicial congelado (invisible). Hay que
     restaurar explicitamente la visibilidad o el hero se ve vacio. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
