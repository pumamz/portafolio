---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, path } from '../../i18n/utils';
import { site } from '../../config/site';
import ParticleField from '../ParticleField.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// El nombre se parte para tratar el apellido de forma distinta. Es lo que
// convierte un titular en una composicion tipografica.
const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');
---

<section
  class="relative flex min-h-[100dvh] flex-col justify-center overflow-hidden px-6 pt-32 pb-28"
>
  {
    /* Resplandor de vino. `pointer-events-none` para que no intercepte
      clics, y aria-hidden porque es puramente decorativo. */
  }
  <div
    aria-hidden="true"
    class="bg-accent/15 parallax-slow pointer-events-none absolute -top-40 -right-40 -z-10 size-[40rem] rounded-full blur-[120px]"
  >
  </div>

  {
    /* Campo de particulas WebGL. Se carga tras el primer pintado, asi que
      el titular es legible antes de que exista una sola particula. */
  }
  <ParticleField />

  <div class="mx-auto w-full max-w-6xl">
    <span class="reveal eyebrow" style="--delay: 0ms">
      <span class="bg-ok inline-block size-1.5 rounded-full" aria-hidden="true"></span>
      {t('contact.availability')}
    </span>

    <h1 class="mt-8 text-5xl">
      <span class="reveal block" style="--delay: 90ms">{firstName}</span>
      {
        lastName && (
          <span class="reveal text-accent block" style="--delay: 180ms">
            {lastName}
          </span>
        )
      }
    </h1>

    <p class="reveal text-text-muted mt-10 max-w-xl text-lg text-pretty" style="--delay: 290ms">
      {site.description[lang]}
    </p>

    <div class="reveal mt-12 flex flex-wrap items-center gap-4" style="--delay: 380ms">
      {
        /* Button-in-button: la flecha nunca va suelta junto al texto, va
          dentro de su propio circulo, a ras del padding interior. Al pasar
          por encima se desplaza y el boton se hunde ligeramente. */
      }
      <a
        href={`${path(lang)}#contact`}
        data-magnetic
        class="group bg-accent text-on-accent hover:bg-accent-hover inline-flex items-center gap-3 rounded-full py-2 pr-2 pl-7 text-base font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] will-change-transform active:scale-[0.98]"
      >
        {t('hero.cta.primary')}
        <span
          aria-hidden="true"
          class="bg-on-accent/15 grid size-9 place-items-center rounded-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
        >
          <Icon
            name="lucide:arrow-right"
            class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
          />
        </span>
      </a>

      <a
        href={`${path(lang)}#work`}
        data-magnetic
        class="group border-border-strong hover:border-accent hover:text-accent inline-flex items-center gap-3 rounded-full border py-2 pr-2 pl-7 text-base font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] will-change-transform active:scale-[0.98]"
      >
        {t('hero.cta.secondary')}
        <span
          aria-hidden="true"
          class="border-border group-hover:border-accent grid size-9 place-items-center rounded-full border transition-colors duration-500"
        >
          <Icon
            name="lucide:arrow-down"
            class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-y-0.5 motion-reduce:group-hover:translate-y-0"
          />
        </span>
      </a>
    </div>
  </div>

  {/* Indicador de scroll. Solo desde sm: en movil el pulgar ya sabe. */}
  <div
    class="text-text-faint absolute inset-x-0 bottom-10 hidden justify-center sm:flex"
    aria-hidden="true"
  >
    <span
      class="scroll-hint flex flex-col items-center gap-2 font-mono text-[0.625rem] tracking-[0.3em] uppercase"
    >
      {t('hero.scroll')}
      <Icon name="lucide:chevron-down" class="size-3.5" />
    </span>
  </div>
</section>

<style>
  /* Entrada escalonada. Cada elemento lleva su propio --delay inline, lo
     que evita escribir una regla CSS por elemento. */
  .reveal {
    animation: reveal 900ms var(--ease-fluid) both;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
      filter: blur(10px);
      /* El recorte hace que el texto emerja desde abajo en lugar de solo
         deslizarse. Es lo que da caracter al titular. */
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
      clip-path: inset(0 0 -25% 0);
    }
  }

  .scroll-hint {
    animation: bob 2.6s var(--ease-fluid) infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    50% {
      transform: translateY(0.4rem);
      opacity: 1;
    }
  }

  /* La regla global de global.css ya neutraliza las animaciones, pero
     `both` deja el estado inicial congelado (invisible). Hay que
     restaurar explicitamente la visibilidad o el hero se ve vacio. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
      clip-path: none;
    }
  }
</style>
