---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, path } from '../../i18n/utils';
import { site } from '../../config/site';
import ParticleField from '../ParticleField.astro';
import photo from '../../assets/daniel.jpeg';

/**
 * Hero de cartel: el nombre ocupa todo el ancho, anclado abajo.
 *
 * La composicion es deliberadamente desequilibrada. Arriba a la izquierda,
 * una linea pequena que dice de que va esto; en medio, vacio; abajo, el
 * nombre a sangre. Ese vacio central es lo que hace que el nombre pese:
 * si el bloque estuviera centrado y rodeado de contenido, seria un titular
 * grande mas. Aislado contra una extension vacia, se lee como un cartel.
 *
 * El nombre se parte en dos para tratar el apellido de forma distinta. Es
 * lo que convierte un dato en una composicion tipografica.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = path(lang);

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: 'GitHub' },
  { href: site.social.linkedin, label: 'LinkedIn' },
].filter((s) => Boolean(s.href));

/**
 * El hero lleva su propio indice, y el carril fijo lo repite.
 *
 * No es duplicado por descuido: es el relevo. Mientras se ve la primera
 * pantalla, la navegacion vive aqui arriba; en cuanto el hero empieza a
 * salir, el carril de la izquierda entra con la misma lista y recoge el
 * testigo. En ningun momento se queda la pagina sin navegacion, que es lo
 * que pasaria si el carril fuera lo unico y solo apareciera al bajar.
 */
const nav = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#stack`, label: t('nav.stack') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

{
  /* `isolate` es imprescindible, no decorativo.
    El canvas y el resplandor usan z-index negativo. Sin un contexto de
    apilamiento propio en esta seccion, ese z negativo los coloca por
    detras del fondo opaco del documento y desaparecen: el campo de
    particulas se renderizaba sin que se viera nada. */
}
<section
  class="full-bleed relative isolate flex min-h-[calc(100dvh-6.5rem)] flex-col justify-between overflow-hidden px-6 pt-10 pb-10 sm:px-10 sm:pt-12 lg:min-h-[100dvh] lg:pt-16"
>
  <div
    aria-hidden="true"
    class="bg-accent/12 parallax-slow pointer-events-none absolute top-1/4 left-1/2 -z-10 size-[34rem] -translate-x-1/2 rounded-full blur-[130px]"
  >
  </div>

  <ParticleField />

  {/* ---------------- Cabecera de la composicion ---------------- */}
  <div class="reveal flex flex-wrap items-start justify-between gap-6" style="--delay: 60ms">
    <div>
      {
        /* La afirmacion va aqui, pequena. El nombre de abajo llama la
          atencion; esta linea es la que dice por que deberia importarte. */
      }
      <p class="font-display text-lg sm:text-xl" style="font-stretch: 85%; font-weight: 700">
        {t('hero.claim.line1')}{' '}
        <span class="text-accent">{t('hero.claim.line2')}</span>
      </p>
      <p class="text-text-faint mt-2 font-mono text-[0.6875rem] tracking-[0.2em] uppercase">
        {t('hero.meta')} / {year}
      </p>
    </div>

    {
      /* Indice numerado arriba a la derecha. Se oculta por debajo de lg,
        donde la tira superior del carril ya lleva el mismo menu. */
    }
    <nav aria-label={t('hero.index')} class="hidden lg:block">
      <ul class="flex flex-wrap items-baseline gap-x-7 gap-y-2">
        {
          nav.map((item, i) => (
            <li>
              <a href={item.href} class="group inline-flex items-baseline gap-2">
                <span class="text-text-faint group-hover:text-accent font-mono text-[0.625rem] tabular-nums transition-colors duration-300">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span
                  class="font-display text-text-muted group-hover:text-text text-sm transition-colors duration-300"
                  style="font-stretch: 85%; font-weight: 700"
                >
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {/* ---------------- Bloque del nombre ---------------- */}
  <div class="mt-16">
    <div class="flex items-end justify-between gap-8">
      <p
        class="reveal text-text-muted max-w-[34ch] text-sm text-pretty sm:text-base"
        style="--delay: 160ms"
      >
        {t('hero.claim.support')}
      </p>

      {
        /* El retrato va junto al nombre, no en el carril: a esta escala
          hace de contrapeso al bloque tipografico y evita que la mitad
          derecha quede vacia. Oculto en movil, donde el nombre ya ocupa
          el ancho entero y la foto lo partiria en dos. */
      }
      <div data-photo-depth class="photo-depth hidden w-40 shrink-0 sm:block lg:w-48">
        <div class="ring-outline relative overflow-hidden rounded-xl">
          <Image
            src={photo}
            alt={t('about.photoAlt')}
            width={420}
            densities={[1, 2]}
            loading="eager"
            class="photo-depth-inner aspect-[4/5] w-full object-cover"
          />
          <div
            aria-hidden="true"
            class="photo-depth-sheen pointer-events-none absolute inset-0 mix-blend-soft-light"
          >
          </div>
        </div>
      </div>
    </div>

    {
      /* El cuerpo se ata al ancho de la ventana con vw, no a la escala
        tipografica del sistema. Es lo que hace que el nombre llegue de
        borde a borde en cualquier pantalla en lugar de dejar un margen
        distinto en cada una. El 13vw esta calculado para "DANIEL PUMA"
        —once caracteres— contra el ancho util descontando el carril. */
    }
    <h1
      class="poster reveal mt-6 text-[clamp(3rem,13vw,13rem)]"
      style="--delay: 240ms"
      aria-label={site.name}
    >
      {
        /* El espacio entre nombre y apellido es un margen, no un caracter.
          Dos motivos: un espacio suelto entre expresiones desaparece al
          formatear el fichero (paso: quedaba "DanielPuma"), y a este
          cuerpo el espacio de la fuente es demasiado ancho. En em, se
          escala solo con el titular. El nombre completo se anuncia desde
          el aria-label del h1. */
      }
      <span aria-hidden="true"
        >{firstName}<span class="text-accent ml-[0.26em]">{lastName}</span></span
      >
    </h1>

    <div
      class="reveal border-border/70 mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t pt-6"
      style="--delay: 320ms"
    >
      <a
        href={`${home}#work`}
        class="group text-text hover:text-accent inline-flex items-center gap-2.5 text-sm font-medium transition-colors duration-300"
      >
        <Icon
          name="lucide:arrow-down"
          class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-y-0.5 motion-reduce:group-hover:translate-y-0"
          aria-hidden="true"
        />
        {t('hero.cta.secondary')}
      </a>

      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-accent group inline-flex items-center gap-1.5 font-mono text-xs tracking-widest uppercase transition-colors duration-300"
              >
                {s.label}
                <Icon
                  name="lucide:arrow-up-right"
                  class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:group-hover:translate-x-0 motion-reduce:group-hover:translate-y-0"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`${home}#contact`}
            class="bg-accent text-on-accent hover:bg-accent-hover inline-flex items-center rounded-full px-5 py-2 text-sm font-medium transition-colors duration-300"
          >
            {t('hero.cta.primary')}
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* Entrada escalonada. Cada elemento lleva su propio --delay inline, lo
     que evita escribir una regla CSS por elemento. */
  .reveal {
    animation: reveal 900ms var(--ease-fluid) both;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
      filter: blur(10px);
      /* El recorte hace que el texto emerja desde abajo en lugar de solo
         deslizarse. Es lo que da caracter al titular. */
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
      clip-path: inset(0 0 -25% 0);
    }
  }

  /* La regla global de global.css ya neutraliza las animaciones, pero
     `both` deja el estado inicial congelado (invisible). Hay que
     restaurar explicitamente la visibilidad o el hero se ve vacio. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
      clip-path: none;
    }
  }
</style>
