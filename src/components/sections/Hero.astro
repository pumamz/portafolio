---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, path } from '../../i18n/utils';
import { site } from '../../config/site';
import { getProjects } from '../../lib/projects';
import { stack } from '../../config/stack';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import ThemeToggle from '../ThemeToggle.astro';
import photo from '../../assets/daniel.png';

/**
 * Hero de cartel que se transforma en el carril lateral al desplazar.
 *
 * La composicion es deliberadamente desequilibrada: arriba a la izquierda
 * una linea pequena que dice de que va esto, en medio vacio, y abajo el
 * nombre a sangre. Ese vacio central es lo que hace que el nombre pese.
 *
 * TODO LO MARCADO CON `data-morph` VUELA. Su pareja en el carril lleva el
 * mismo `data-morph-to`, y `hero-morph.ts` mide las dos posiciones y
 * resta. Aqui no hay ni una coordenada escrita a mano: si cambia un
 * padding o el ancho del carril, el destino se recalcula solo.
 *
 * Condicion para emparejar: el contenido tiene que ser IDENTICO a los dos
 * lados. Lo que no tiene equivalente exacto —la afirmacion, el texto de
 * apoyo, las llamadas a la accion— no vuela: se va con el scroll como
 * cualquier contenido normal. Hacer viajar dos textos distintos se lee
 * como un fallo de render, no como una transformacion.
 */
interface Props {
  /** Ruta equivalente en el otro idioma, para el conmutador del hero. */
  altPath?: string;
}

const { altPath } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = path(lang);

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

/* La AFIRMACION se parte en letras para que entren una a una.

   El indice de cada letra viaja en una variable CSS y de ahi sale su
   retardo, lo que evita escribir una regla por letra. El desfase es mas
   corto que el que llevaba el nombre porque aqui hay treinta y tantos
   caracteres y no diez: con 42 ms la frase tardaria mas de un segundo y
   medio en acabar de entrar.

   Trocear no afecta a un lector de pantalla: el bloque es aria-hidden y
   la frase entera va aparte en una etiqueta para lectura. */
const claim1 = t('hero.claim.line1');
const claim2 = t('hero.claim.line2');
const claimLetras = [
  ...[...claim1].map((ch) => ({ ch, acento: false })),
  ...[...` ${claim2}`].map((ch) => ({ ch, acento: true })),
];

const year = new Date().getFullYear();

const socials = [
  { href: site.social.github, label: 'GitHub' },
  { href: site.social.linkedin, label: 'LinkedIn' },
].filter((s) => Boolean(s.href));

/**
 * Las cifras se calculan del contenido real, nunca se escriben a mano: si
 * manana entra un proyecto, el numero sube solo. Un dato desactualizado en
 * un portafolio transmite mas descuido que no poner ninguno.
 */
const projects = await getProjects(lang);
const led = projects.filter((p) => /lider|lead/i.test(p.data.role)).length;
const techCount = stack.reduce((total, group) => total + group.items.length, 0);

const stats = [
  { value: projects.length, label: t('stats.projects') },
  { value: led, label: t('stats.led') },
  { value: 2023, label: t('stats.since') },
  { value: techCount, label: t('stats.stack') },
];

const nav = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#stack`, label: t('nav.stack') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

{
  /* Sin `overflow-hidden` en la seccion: las piezas que vuelan salen de su
    caja por arriba y a la izquierda, y un recorte aqui las decapitaria a
    mitad del viaje. El recorte se aplica solo a las capas de fondo, que
    son las unicas que se desbordan de verdad.

    `z-30` la pone por encima del panel del carril (z-20), que es adonde
    aterrizan las piezas, y por encima de las secciones que vienen
    despues, que no llevan z-index. */
}
{
  /* EL CONTENEDOR ALTO ES EL QUE BLOQUEA EL SCROLL.

    Mide 190vh a partir de lg: una pantalla para el hero y el resto para
    recorrer la transformacion. La seccion va dentro en `sticky top-0`,
    asi que se queda quieta mientras se atraviesa ese alto y solo se
    marcha cuando el contenedor se acaba. Eso es lo que hace que el hero
    parezca bloqueado sin secuestrar la rueda del raton: el scroll sigue
    siendo el del navegador, con su inercia y su barra, y quien quiera
    pasar de largo puede hacerlo.

    En movil no hay carril al que transformarse, asi que no hay bloqueo:
    el contenedor no tiene alto extra y la seccion no se ancla. */
}
<div data-morph-pin class="relative">
  <section
    data-morph-root
    data-reactive-grid
    class="full-bleed relative z-30 flex min-h-[calc(100dvh-6.5rem)] flex-col justify-between px-6 pt-10 pb-10 sm:px-10 sm:pt-12 lg:sticky lg:top-0 lg:h-screen lg:min-h-0 lg:pt-16"
  >
    <div
      aria-hidden="true"
      data-hero-exit
      data-reactive-grid-target
      class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
    >
      {
        /* Foco que sigue al puntero. Las variables --grid-x / --grid-y las
        escribe el script de la rejilla reactiva sobre la seccion; esta
        capa solo las lee. NO declararlas aqui: una propiedad declarada en
        el hijo gana a la heredada y el foco se queda clavado en el
        centro. Paso exactamente eso. */
      }
      {
        /* Mancha de acento que deriva despacio. El campo de estrellas ya se
        mueve, pero es un movimiento uniforme; esto da una corriente lenta
        de fondo que cambia la pantalla sin que se note el bucle. */
      }
      <div
        data-anima
        class="aurora bg-accent/12 absolute top-1/4 left-1/3 size-[38rem] rounded-full blur-[130px]"
      >
      </div>

      <div class="spotlight text-text absolute inset-0"></div>
      <div class="grain absolute inset-0"></div>
    </div>

    {
      /* ---------------- Lo que ocupa la derecha durante el bloqueo ----

      Mientras el hero esta anclado, todas sus piezas migran hacia el
      carril de la izquierda y la mitad derecha se queda vacia: dos
      tercios de pantalla sin nada mientras dura la transformacion. Este
      panel entra justo a ese hueco, en contra del resto.

      Lleva las cifras porque son la prueba de lo que afirma el titular y
      porque se calculan del contenido real. Es contenido, no relleno: si
      hubiera que poner adorno ahi, sobraria el bloqueo entero.

      Se ancla al borde del carril y se CENTRA en lo que queda, en lugar de
      pegarse al borde derecho con un porcentaje. Pegado a la derecha, el
      hueco entre carril y cifras crecia con el ancho de pantalla: a 2560
      quedaba una franja central muerta.

      `aria-hidden` no: es informacion de verdad. Pero si
      `pointer-events-none`, porque no hay nada que pulsar y no debe
      robarle clics al hero. */
    }
    <div
      data-hero-reveal
      class="pointer-events-none absolute inset-y-0 right-0 left-64 hidden items-center justify-center px-10 opacity-0 lg:flex"
    >
      <dl class="grid w-full max-w-xl grid-cols-2 gap-x-10 gap-y-10">
        {
          stats.map((stat) => (
            <div class="border-border/70 border-t pt-4">
              {/* tabular-nums: sin cifras de ancho fijo los numeros de cada
                columna no alinean y la rejilla se ve descuadrada. */}
              <dd
                class="font-display text-accent text-[clamp(2.25rem,3.4vw,3.75rem)] tabular-nums"
                style="font-stretch: 70%; font-weight: 900"
              >
                {stat.value}
              </dd>
              <dt class="text-text-muted mt-2 text-sm">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    {/* ---------------- Cabecera de la composicion ---------------- */}
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div data-hero-fade class="reveal" style="--delay: 60ms">
        <p
          class="font-display text-lg sm:text-xl"
          style="font-stretch: 85%; font-weight: 700"
          aria-label={`${claim1} ${claim2}`}
        >
          <span class="claim-in" data-anima aria-hidden="true">
            {
              claimLetras.map((l, i) => (
                <span class:list={['ltr', l.acento && 'text-accent']} style={`--i:${i}`} data-anima>
                  {l.ch === ' ' ? '\u00A0' : l.ch}
                </span>
              ))
            }
          </span>
        </p>
        <p class="text-text-faint mt-2 font-mono text-[0.6875rem] tracking-[0.2em] uppercase">
          {t('hero.meta')} / {year}
        </p>
      </div>

      {
        /* El indice del hero ES el del carril: estos mismos enlaces vuelan
        hasta alla. Oculto por debajo de lg, donde manda la tira superior. */
      }
      <nav data-morph-group="hero" aria-label={t('hero.index')} class="hidden lg:block">
        <ul class="flex flex-wrap items-baseline gap-x-7 gap-y-2">
          {
            nav.map((item, i) => (
              <li>
                <a
                  href={item.href}
                  data-morph={`nav-${i}`}
                  class="group relative z-20 inline-flex items-baseline gap-3 text-sm"
                >
                  <span class="text-text-faint group-hover:text-accent w-5 shrink-0 font-mono text-[0.6875rem] tabular-nums transition-colors duration-300">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-text-muted group-hover:text-text transition-colors duration-300">
                    {item.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* ---------------- Bloque del nombre ---------------- */}
    <div class="mt-16">
      <div class="flex items-end justify-between gap-8">
        <p
          data-hero-fade
          class="reveal text-text-muted max-w-[34ch] text-sm text-pretty sm:text-base"
          style="--delay: 160ms"
        >
          {t('hero.claim.support')}
        </p>

        {
          /* El flotar va en el HIJO. La pieza que vuela lleva el transform
            que escribe el script, y una animacion CSS sobre transform
            ganaria en la cascada y se lo comeria. */
        }
        <div data-morph="photo" class="hidden w-40 shrink-0 sm:block lg:w-48">
          <div data-anima class="float-idle ring-outline relative overflow-hidden rounded-xl">
            <Image
              src={photo}
              alt={t('about.photoAlt')}
              width={420}
              densities={[1, 2]}
              loading="eager"
              class="aspect-[4/5] w-full object-cover"
            />
          </div>
        </div>
      </div>

      {
        /* El cuerpo se ata al ancho de la ventana con vw, no a la escala
        tipografica del sistema: es lo que hace que el nombre llegue de
        borde a borde en cualquier pantalla. El 18vw esta medido, no
        estimado: a 13vw el nombre ocupaba 963 px de los 1360 utiles a
        1440 de ancho y quedaba un tercio de pantalla muerto a su derecha.
        La firma del carril tambien esta en vw, para que el cociente de
        escala del viaje no cambie al redimensionar. */
      }
      <h1
        data-morph="name"
        class="poster relative z-10 mt-6 text-[clamp(2rem,14vw,7rem)] lg:text-[17.5vw]"
        aria-label={site.name}
      >
        {
          /* El espacio entre nombre y apellido es un margen, no un caracter:
          un espacio suelto entre expresiones desaparece al formatear el
          fichero —paso, quedaba "DanielPuma"— y a este cuerpo el espacio
          de la fuente es demasiado ancho. */
        }
        <span class="name-in" data-anima aria-hidden="true">
          {
            [...firstName].map((ch, i) => (
              <span class="inline-block" style={`--i:${i}`}>
                {ch}
              </span>
            ))
          }
          {
            [...lastName].map((ch, i) => (
              <span
                class:list={['text-accent inline-block', i === 0 && 'ml-[0.26em]']}
                style={`--i:${firstName.length + i}`}
              >
                {ch}
              </span>
            ))
          }
        </span>
      </h1>

      {
        /* La linea va en su propio elemento y no como borde de la barra: la
        barra no puede apagarse porque lleva dentro las redes, que vuelan.
        El filete si se apaga con el resto del hero. */
      }
      <div data-hero-fade aria-hidden="true" class="border-border/70 mt-8 border-t"></div>

      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 pt-6">
        {
          /* Conmutadores propios del hero.

            Los del carril estan a opacidad cero durante toda la primera
            pantalla, asi que en escritorio no habia NINGUNO utilizable
            hasta terminar el bloqueo. Estos se apagan justo cuando los del
            carril se encienden, de modo que siempre hay exactamente un
            juego usable y nunca dos. */
        }
        <div
          data-hero-fade
          data-morph-group="hero"
          class="order-last flex items-center gap-2 lg:order-none"
        >
          <LanguageSwitcher altPath={altPath} />
          <ThemeToggle />
        </div>

        <a
          href={`${home}#work`}
          data-hero-fade
          class="group text-text hover:text-accent reveal inline-flex items-center gap-2.5 text-sm font-medium transition-colors duration-300"
          style="--delay: 320ms"
        >
          <Icon
            name="lucide:arrow-down"
            data-anima
            class="bob size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-y-0.5 motion-reduce:group-hover:translate-y-0"
            aria-hidden="true"
          />
          {t('hero.cta.secondary')}
        </a>

        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            socials.map((s, i) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-morph={`social-${i}`}
                  class="text-text-muted hover:text-accent group relative z-20 inline-flex items-center gap-1.5 font-mono text-xs tracking-widest uppercase transition-colors duration-300"
                >
                  {s.label}
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:group-hover:translate-x-0 motion-reduce:group-hover:translate-y-0"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
          <li data-hero-fade class="reveal" style="--delay: 380ms">
            <a
              href={`${home}#contact`}
              class="bg-accent text-on-accent hover:bg-accent-hover inline-flex items-center rounded-full px-5 py-2 text-sm font-medium transition-colors duration-300"
            >
              {t('hero.cta.primary')}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</div>

<style>
  /* ENTRADA DEL NOMBRE.

     Se descubre de abajo arriba, como un cartel al que le quitan la funda,
     y entra enfocandose en lugar de simplemente apareciendo.

     Va en el HIJO y no en el h1 porque el h1 lleva el transform que
     escribe el script del viaje, y una animacion CSS sobre transform
     ganaria en la cascada y lo pisaria.

     Y solo anima `clip-path`, `opacity` y `filter`: NINGUNA de las tres
     cambia la caja del elemento. Es deliberado: el script mide la tinta
     del nombre al cargar y otra vez cuando llegan las tipografias, y esa
     segunda medida cae justo dentro de esta animacion. Con un `transform`
     o un `scale` aqui, mediria una caja a medio animar y el nombre
     aterrizaria descolocado en el carril. */
  /* EL NOMBRE: revelado limpio de una pieza.

     La cascada letra a letra se movio a la afirmacion. Aqui vuelve el
     revelado del conjunto, que a este cuerpo funciona mejor: once letras
     de 250 px entrando por turnos se leen como desorden, no como cartel. */
  .name-in {
    display: block;
    animation:
      name-wipe 1000ms var(--ease-fluid) backwards,
      name-focus 1000ms var(--ease-fluid) backwards;
    clip-path: inset(-25% 0 -25% 0);
  }

  @keyframes name-focus {
    from {
      opacity: 0;
      filter: blur(26px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* LA AFIRMACION: letra a letra. */
  .claim-in {
    display: inline-block;
  }

  .ltr {
    display: inline-block;
    /* El retardo sale del indice, asi no hace falta una regla por letra. */
    animation: ltr-in 620ms var(--ease-fluid) calc(240ms + var(--i) * 16ms) backwards;
  }

  @keyframes name-wipe {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(-25% 0 -25% 0);
    }
  }

  @keyframes ltr-in {
    from {
      opacity: 0;
      /* En em, para que el recorrido escale con el cuerpo del titular. */
      transform: translateY(0.42em);
      filter: blur(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* ---------------- Movimiento en reposo ----------------
     Sin esto el hero se queda completamente quieto en cuanto termina de
     entrar. Son dos gestos lentos y de poca amplitud: lo justo para que la
     pantalla respire, no para llamar la atencion sobre si mismos. */
  /* La amplitud se apaga conforme avanza el viaje.

     El retrato es una pieza que vuela, y el aterrizaje tiene que caer al
     pixel. Con el flotar a amplitud fija llegaba oscilando y se quedaba
     hasta 5 px desviado de su destino, segun en que punto del ciclo
     estuviera. Multiplicando por lo que queda de recorrido, la amplitud
     es cero exactamente cuando aterriza, y en el hero —donde importa que
     se mueva— esta entera. */
  .float-idle {
    --idle: calc(1 - var(--morph-p, 0));
    animation: float-idle 9s var(--ease-fluid) infinite;
  }

  @keyframes float-idle {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(calc(-0.5rem * var(--idle)));
    }
  }

  /* La flecha que invita a bajar late despacio. Es una pista de uso, no
     un adorno: lo que se mueve en una pagina quieta es lo que se mira. */
  .bob {
    animation: bob 3.2s var(--ease-fluid) infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(0.3rem);
      opacity: 1;
    }
  }

  /* El acento del nombre respira. Solo `text-shadow`, que no toca la
     caja: el nombre es una pieza que vuela y su medida no puede cambiar. */
  .name-in :global(.text-accent) {
    animation: glow 7s ease-in-out infinite;
  }

  @keyframes glow {
    0%,
    100% {
      text-shadow: 0 0 0 transparent;
    }
    50% {
      text-shadow: 0 0 2.5rem color-mix(in oklch, var(--accent) 45%, transparent);
    }
  }

  .aurora {
    animation: aurora 24s var(--ease-fluid) infinite;
  }

  @keyframes aurora {
    0%,
    100% {
      transform: translate3d(-8%, -4%, 0) scale(1);
      opacity: 0.5;
    }
    50% {
      transform: translate3d(8%, 6%, 0) scale(1.15);
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name-in,
    .name-in :global(.text-accent),
    .claim-in,
    .ltr,
    .bob,
    .float-idle,
    .aurora {
      animation: none;
    }
  }

  /* Entrada escalonada al cargar. Nada que ver con la transformacion al
     carril, que la gobierna el scroll: esto solo es la llegada inicial.
     Cada elemento lleva su propio --delay inline, lo que evita escribir
     una regla CSS por elemento. */
  /* `backwards` y NO `both`, que es lo que estaba puesto.
 
     Con `both`, al terminar la animacion el elemento se queda congelado
     en su fotograma final, que incluye `opacity: 1`. Un fotograma
     retenido gana a una declaracion normal en la cascada, asi que
     bloqueaba el fundido de salida del hero: el titular seguia encima del
     carril y las redes pisaban a "Ver proyectos". Se veia como un fallo
     de maquetacion y era un fallo de animacion.
 
     `backwards` aplica el fotograma inicial SOLO durante el retardo —que
     es para lo que hace falta, para que no parpadee antes de entrar— y al
     acabar suelta el elemento a sus estilos normales. */
  .reveal {
    animation: reveal 900ms var(--ease-fluid) backwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* La regla global de global.css ya neutraliza las animaciones, pero
     `both` deja el estado inicial congelado (invisible). Hay que
     restaurar explicitamente la visibilidad o el hero se ve vacio. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
