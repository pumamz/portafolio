---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { stack } from '../../config/stack';
import SectionHeading from '../SectionHeading.astro';
import TechSphere from '../TechSphere.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section data-reactive-grid class="border-border/60 relative border-y">
  {
    /* Rejilla tenue de fondo. La mascara sigue al cursor: el area cercana
      al puntero se revela y el resto se apaga, como si la superficie
      reaccionara al tacto. Las variables las escribe el script. */
  }
  <div
    aria-hidden="true"
    class="reactive-grid pointer-events-none absolute inset-0 -z-10 [background-image:linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] [background-size:56px_56px]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6 py-28 sm:py-36">
    <SectionHeading
      id="stack"
      index="03"
      eyebrow={t('stack.eyebrow')}
      title={t('stack.title')}
      intro={t('stack.intro')}
    />

    {
      /* Esfera arrastrable. Es una vista alternativa del mismo contenido
        que la rejilla de abajo, no informacion nueva: si el 3D falla o el
        visitante usa lector de pantalla, no se pierde nada. */
    }
    <div class="mt-16 flex justify-center">
      <TechSphere lang={lang} label={t('stack.sphereLabel')} hint={t('stack.sphereHint')} />
    </div>

    {
      /* Bento asimetrico: los grupos nucleares ocupan el doble de ancho.
        Una rejilla uniforme de cuatro columnas trataria "Backend" y
        "Datos" como si pesaran lo mismo, y no es cierto. */
    }
    <div class="reveal-stagger mt-16 grid gap-5 md:grid-cols-2">
      {
        stack.map((group) => (
          <div class="bezel-shell group/card">
            <div class="bezel-core h-full p-7 sm:p-8">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-text font-mono text-xs tracking-[0.2em] uppercase">
                  {group.label[lang]}
                </h3>
                <span class="text-text-faint font-mono text-xs tabular-nums">
                  {String(group.items.length).padStart(2, '0')}
                </span>
              </div>

              <ul class="mt-7 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
                {group.items.map((tech) => (
                  <li>
                    {/* Cada logo en su propia celda con relieve. El nombre
                        siempre visible: un logo sin etiqueta obliga a
                        reconocerlo, y no todo reclutador conoce todos.

                        El color de marca entra como variable CSS y solo se
                        aplica en hover. Sin `brand` (Vercel, Railway) la
                        variable no existe y el fallback deja el color del
                        tema, que es justo lo que necesitan. */}
                    <div
                      class="group/tech border-border/60 bg-bg-subtle/60 relative flex h-full flex-col items-center gap-2.5 rounded-2xl border px-3 py-4 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-0.5 hover:border-(--brand,--color-accent)"
                      style={
                        tech.brand
                          ? `--brand-light:${tech.brand.light};--brand-dark:${tech.brand.dark}`
                          : undefined
                      }
                    >
                      <Icon
                        name={tech.icon}
                        class="text-text-muted size-7 transition-[color,transform] duration-300 group-hover/tech:scale-110 group-hover/tech:text-(--brand-light,--color-text) motion-reduce:group-hover/tech:scale-100 dark:group-hover/tech:text-(--brand-dark,--color-text)"
                      />
                      <span class="text-text-muted group-hover/tech:text-text text-center text-xs leading-tight transition-colors duration-300">
                        {tech.name}
                      </span>

                      {/* Donde se uso, en un tooltip propio. Es el dato que
                          convierte una lista de logos en evidencia. */}
                      <span
                        role="tooltip"
                        class="glass text-text pointer-events-none absolute -top-2 left-1/2 z-20 w-max max-w-[10rem] -translate-x-1/2 -translate-y-full rounded-xl px-2.5 py-1.5 text-center text-[0.6875rem] leading-tight opacity-0 transition-opacity duration-300 group-hover/tech:opacity-100"
                      >
                        {tech.note[lang]}
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
