---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Icon } from 'astro-icon/components';
import { getProjects, workIndexUrl } from '../../lib/projects';
import ProjectCard from '../ProjectCard.astro';
import SectionHeading from '../SectionHeading.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<section class="mx-auto max-w-6xl px-6 py-28 sm:py-36">
  <SectionHeading id="work" title={t('work.title')} intro={t('work.intro')} />

  {
    /* Rejilla 2x2 en la portada. Cuatro proyectos en columna ocupaban casi
      tres pantallas de desplazamiento y el visitante llegaba cansado a la
      cuarta tarjeta. En dos columnas se ven los cuatro de una vez, que es
      lo que hace que se lean como un cuerpo de trabajo y no como una lista.
      El problema y la solucion completos siguen a un clic, en el caso de
      estudio; aqui solo va el impacto. */
  }
  <div class="reveal-stagger mt-16 grid gap-6 lg:grid-cols-2">
    {
      projects.map((project, i) => (
        <ProjectCard project={project} index={i + 1} variant="compact" />
      ))
    }
  </div>

  <div class="mt-12 flex justify-center">
    <a
      href={workIndexUrl(lang)}
      class="group border-border-strong hover:border-accent hover:text-accent inline-flex items-center gap-2.5 rounded-full border px-6 py-3 text-sm font-medium transition-colors duration-300"
    >
      {t('work.viewAll')}
      <Icon
        name="lucide:arrow-right"
        class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
      />
    </a>
  </div>
</section>
