---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getProjects } from '../../lib/projects';
import ProjectCard from '../ProjectCard.astro';
import SectionHeading from '../SectionHeading.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
  <SectionHeading id="work" index="01" title={t('work.title')} intro={t('work.intro')} />

  {
    /* Una columna a proposito, no una rejilla. Con cuatro proyectos, unas
      tarjetas anchas dejan sitio para contar el problema y el impacto;
      una rejilla obligaria a recortarlo todo a un titulo y un icono. */
  }
  <div class="mt-14 flex flex-col gap-6">
    {projects.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
  </div>
</section>
