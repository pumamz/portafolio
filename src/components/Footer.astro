---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { site } from '../config/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const year = new Date().getFullYear();

const links = [
  { href: site.social.github, label: 'GitHub' },
  { href: site.social.linkedin, label: 'LinkedIn' },
  { href: site.social.x, label: 'X' },
].filter((l) => l.href);
---

<footer class="border-border/60 border-t">
  <div
    class="text-text-faint mx-auto flex max-w-5xl flex-col gap-6 px-6 py-12 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <p>{`© ${year} ${site.name}. ${t('footer.rights')}.`}</p>

    <ul class="flex flex-wrap items-center gap-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-text decoration-accent underline-offset-4 transition-colors duration-150 hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
