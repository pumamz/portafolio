---
import { Icon } from 'astro-icon/components';
import type { Project } from '../lib/projects';
import { projectUrl } from '../lib/projects';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  /** Numero visible de la tarjeta: 01, 02... */
  index: number;
  /**
   * Nivel del encabezado del titulo.
   * En la portada la tarjeta cuelga de un h2 de seccion, asi que es h3.
   * En el indice de proyectos cuelga del h1, asi que debe ser h2: saltar
   * de h1 a h3 rompe la navegacion por encabezados de los lectores.
   */
  headingLevel?: 2 | 3;
}

const { project, index, headingLevel = 3 } = Astro.props;
const d = project.data;
const t = useTranslations(d.lang as Lang);
const href = projectUrl(project);
const num = String(index).padStart(2, '0');
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{
  /* La perspectiva vive en el contenedor y la rotacion en el hijo: si
    ambas estuvieran en el mismo elemento, cada tarjeta tendria su propio
    punto de fuga y el conjunto no se leeria como un espacio unico. */
}
<div class="perspective-container">
  {
    /* Doble bisel: marco exterior con reborde, nucleo dentro. La tarjeta
      deja de ser un rectangulo sobre el fondo y pasa a parecer una pieza
      encajada en una bandeja. */
  }
  <div class="bezel-shell group hover:bg-accent/[0.06] transition-colors duration-700">
    <article data-tilt class="bezel-core tilt-card relative isolate overflow-hidden p-8 sm:p-10">
      {/* Brillo radial que sigue al puntero. */}
      <div
        aria-hidden="true"
        class="tilt-sheen pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-700 group-hover:opacity-100 motion-reduce:transition-none"
      >
      </div>

      <div class="flex items-start justify-between gap-8">
        <div class="min-w-0">
          <div class="flex items-center gap-3">
            <span class="text-accent font-mono text-xs tabular-nums" aria-hidden="true">{num}</span>
            <span class="bg-border h-px w-8" aria-hidden="true"></span>
            <span class="text-text-faint font-mono text-xs tracking-widest uppercase">
              {d.period}
            </span>
          </div>

          <Heading class="mt-5 text-2xl">
            {
              /* El enlace envuelve solo el titulo, pero ::after lo extiende
                a toda la tarjeta. Asi el area clicable es grande y el
                lector de pantalla anuncia un unico enlace descriptivo. */
            }
            <a href={href} class="after:absolute after:inset-0 after:content-['']">
              {d.title}
            </a>
          </Heading>

          <p class="text-text-muted mt-4 max-w-prose text-base text-pretty">{d.tagline}</p>
        </div>

        {
          /* Icono anidado en su propio circulo, no suelto junto al texto.
            Al pasar por encima se desplaza en diagonal: tension interna. */
        }
        <span
          aria-hidden="true"
          class="border-border bg-bg-subtle text-text-muted group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent grid size-11 shrink-0 place-items-center rounded-full border transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
        >
          <Icon
            name="lucide:arrow-up-right"
            class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:group-hover:translate-x-0 motion-reduce:group-hover:translate-y-0"
          />
        </span>
      </div>

      <dl class="border-border/60 mt-8 grid gap-6 border-t pt-8 sm:grid-cols-2">
        <div>
          <dt
            class="text-text-faint flex items-center gap-2 font-mono text-[0.625rem] tracking-[0.2em] uppercase"
          >
            <Icon name="lucide:target" class="size-3" />
            {t('work.problem')}
          </dt>
          <dd class="text-text-muted mt-3 text-sm leading-relaxed">{d.problem}</dd>
        </div>
        <div>
          <dt
            class="text-text-faint flex items-center gap-2 font-mono text-[0.625rem] tracking-[0.2em] uppercase"
          >
            <Icon name="lucide:trending-up" class="size-3" />
            {t('work.impact')}
          </dt>
          <dd class="text-text-muted mt-3 text-sm leading-relaxed">{d.impact}</dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <ul class="flex flex-wrap gap-2" aria-label={t('work.stack')}>
          {
            d.stack.map((tech) => (
              <li class="border-border/70 text-text-muted rounded-full border px-3 py-1 font-mono text-[0.6875rem]">
                {tech}
              </li>
            ))
          }
        </ul>

        {
          d.liveUrl && (
            // z-10 lo eleva sobre el ::after de la tarjeta; sin esto el
            // enlace al caso de estudio se lo tragaria.
            <a
              href={d.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent relative z-10 ml-auto inline-flex items-center gap-1.5 text-sm underline-offset-4 hover:underline"
            >
              {t('work.viewLive')}
              <Icon name="lucide:external-link" class="size-3.5" />
            </a>
          )
        }
      </div>
    </article>
  </div>
</div>
