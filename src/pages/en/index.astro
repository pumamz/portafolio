---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import Work from '../../components/sections/Work.astro';
import About from '../../components/sections/About.astro';
import Timeline from '../../components/sections/Timeline.astro';
import Stack from '../../components/sections/Stack.astro';
import Services from '../../components/sections/Services.astro';
import Contact from '../../components/sections/Contact.astro';
import { site } from '../../config/site';
import { path } from '../../i18n/utils';

const lang = 'en' as const;
---

<BaseLayout title={`${site.name} - ${site.jobTitle[lang]}`} altPath={path('es')}>
  <Hero />
  <Work />
  <About />
  <Timeline />
  <Stack />
  <Services />
  <Contact />
</BaseLayout>
