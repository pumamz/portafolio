---
import '@fontsource-variable/archivo/wdth.css';
// Las URLs con hash de las dos caras que se usan sobre el pliegue, para
// poder precargarlas. `?url` hace que Vite devuelva la ruta final en vez
// de incrustar el fichero.
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import geistWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

import { site } from '../config/site';
import { getLangFromUrl, useTranslations, localeCodes, otherLang, path } from '../i18n/utils';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import PointerEffects from '../components/PointerEffects.astro';

interface Props {
  title: string;
  description?: string;
  /** Ruta equivalente en el otro idioma, para hreflang y el conmutador. */
  altPath?: string;
}

const { title, description, altPath } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other = otherLang(lang);

const desc = description ?? site.description[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altPath ?? path(other), Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);

/**
 * Datos estructurados. Google los usa para el panel de conocimiento
 * y algunos ATS los leen al indexar perfiles.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle[lang],
  email: `mailto:${site.email}`,
  url: site.url,
  sameAs: Object.values(site.social).filter(Boolean),
};
---

<!doctype html>
<html lang={localeCodes[lang]} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {
      /* Las dos caras que se usan sobre el pliegue se piden a la vez que
        el CSS, no despues de analizarlo. Medido: 139 KB de fuentes sin
        precargar llegaban 708 ms despues del primer pintado y provocaban
        todo el desplazamiento de maquetacion de la pagina. Solo estas
        dos: precargar lo que no se usa de inmediato roba ancho de banda
        a lo que si. */
    }
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistWoff2} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang: le dice a Google que son la misma pagina en dos idiomas,
         evitando que las trate como contenido duplicado. -->
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(path('es'), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={localeCodes[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Estado inicial de la transformacion, ANTES del primer pintado.

         Sin esto la pagina se pintaba una vez con el carril entero visible
         —que es el estado correcto cuando no hay JavaScript— y el modulo
         lo ocultaba un instante despues: el visitante veia el carril y las
         piezas del hero aparecer y desaparecer de golpe. Ese era el "tic"
         al cargar o recargar.

         Marca solo el ARRANQUE, no la transformacion en si. Asi, si el
         modulo nunca llega a ejecutarse, no queda ni pantalla y media de
         scroll muerto ni un carril a medias: se ve el hero, que ya lleva
         su propio indice y sus conmutadores. -->
    <script is:inline>
      (() => {
        const apto =
          matchMedia('(min-width: 64rem)').matches &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!apto) return;

        const html = document.documentElement;
        html.dataset.morphBoot = '';

        // Red de seguridad: si el modulo no se hace cargo (fallo de red,
        // error de script), se deshace el arranque y la pagina vuelve al
        // estado sin transformacion, que es completo y navegable. Sin
        // esto quedaria un carril invisible para siempre.
        setTimeout(() => {
          if (html.dataset.morph !== 'on') delete html.dataset.morphBoot;
        }, 3000);
      })();
    </script>

    <!-- Tema: se aplica ANTES del primer pintado para evitar el
         destello blanco al cargar en modo oscuro. Por eso es inline
         y sincrono, no un componente. -->
    <script is:inline>
      (() => {
        const apply = () => {
          const stored = localStorage.getItem('theme');
          const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle(
            'dark',
            stored === 'dark' || (!stored && prefersDark),
          );
        };

        apply();

        // Con view transitions el <head> se reemplaza pero este script no
        // se vuelve a ejecutar, asi que el tema se perderia al navegar.
        // La guarda evita registrar el listener dos veces.
        if (!window.__themeListenerAttached) {
          window.__themeListenerAttached = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>

    <ClientRouter />
  </head>

  {
    (
      /* OJO CON EL FONDO. El lienzo de estrellas va en z-10 NEGATIVO para
      quedar por detras de todo el contenido sin capturar clics. Para que
      se vea, <body> NO puede pintar fondo: si lo hiciera, taparia un hijo
      con z negativo y el lienzo renderizaria sin que se viera nada. Ya
      paso con el canvas de particulas.

      El color de fondo lo pone <html> en global.css, y ese sube al lienzo
      de la ventana, que se pinta por debajo incluso de los z negativos.
      Por eso funciona, y por eso aqui no hay `bg-bg`. */

      <body class="text-text antialiased">
        <canvas
          data-gravity-stars
          aria-hidden="true"
          class="pointer-events-none fixed inset-0 -z-10"
        />

        <a
          href="#main"
          class="focus-visible:bg-accent focus-visible:text-on-accent sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-50 focus-visible:rounded-md focus-visible:px-4 focus-visible:py-2"
        >
          {t('nav.skipToContent')}
        </a>

        {/* Barra de progreso de lectura. `scroll-progress` la vincula al
        scroll del documento con animation-timeline, sin JavaScript: la
        anima el compositor y no toca el hilo principal. */}
        <div
          aria-hidden="true"
          class="bg-accent scroll-progress fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0"
        />

        <PointerEffects />

        <Sidebar altPath={altPath} />

        {/* El contenido se aparta del carril fijo a partir de lg. El hero se
        sale de ese margen a proposito —ver `full-bleed` en global.css—
        porque su composicion necesita los dos bordes de la ventana.

        En movil no hay carril lateral, solo la tira superior del
        componente, asi que el hueco es por arriba. */}
        <div class="pt-[6.5rem] lg:pt-0 lg:pl-64">
          <main id="main">
            <slot />
          </main>

          <Footer />
        </div>
      </body>
    )
  }
</html>
